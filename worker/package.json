{
  "name": "abvx-shortener-worker",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate-kv": "node ./scripts/migrate-kv.mjs",
    "migrate-kv:dry": "DRY_RUN=true LOG_FORMAT=json MAX_KEYS=20 LIMIT=200 node ./scripts/migrate-kv.mjs",
    "migrate-kv:canary": "LOG_FORMAT=json MAX_KEYS=200 LIMIT=200 node ./scripts/migrate-kv.mjs",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "wrangler": "^3.102.0",
    "zod": "^3.24.1"
  }
}
